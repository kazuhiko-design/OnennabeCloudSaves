MaxProgress":0},{"strID":"Trophy_Title_27","strName":"Master Mako Stone Miner","strDescription":"Prevented the Materia Room from being shut down.","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1608070/fcc8d47f614ba4faf5f179cf9946574da1a23e43.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":34.5,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"Trophy_Title_43","strName":"Shinra's Squats Champion","strDescription":"Achieved victory against the SOLDIER 2nd Class in the physical fitness test.","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1608070/48bbe39755509cf3c60f6953b8cd3a72942a91ff.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":31.200000762939453,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"Trophy_Title_33","strName":"Cell Raider","strDescription":"Checked all cells on the 67th floor of the Shinra Building.","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1608070/ec3fc6b87a9fc1458de5fa4c47e9da39272d4499.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":29.600000381469727,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"Trophy_Title_41","strName":"Bingo!","strDescription":"Guessed the exact number in the number-guessing game.","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1608070/0c3edd120559cf08d5342c84a4a1b3c7c77ce089.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":28.299999237060547,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"Trophy_Title_34","strName":"Wutai's Nemesis","strDescription":"Caught all the Wutai spies that had infiltrated Midgar.","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1608070/3149e53f6ed1abfa3a7f68199cbb18871244ffb5.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":25.700000762939453,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0}],"vecAchievedHidden":[],"nTotal":51,"nAchieved":0}}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Square Enix","strURL":"https://store.steampowered.com/developer/squareenix"},{"strName":"TOSE CO., LTD.","strURL":null}],"rgPublishers":[{"strName":"Square Enix","strURL":"https://store.steampowered.com/publisher/squareenix"}],"rgFranchises":[{"strName":"FINAL FANTASY","strURL":"https://store.steampowered.com/curator/34459938"}]}}],["descriptions",{"version":1,"data":{"strFullDescription":"CRISIS CORE –FINAL FANTASY VII– REUNION is the HD remaster version of the smash hit prequel to FINAL FANTASY VII.\r\n\r\nIn addition to all graphics being remastered in HD, fully voiced dialogue and new soundtrack arrangements make for a dynamic new retelling of a beloved classic.\r\n\r\nCRISIS CORE –FINAL FANTASY VII– REUNION follows the story of Zack Fair, a young warrior admired by the boy destined to save the world, trusted by men renowned as heroes of legend, and loved by the girl who holds the fate of the planet in her hands. The tale of Zack's dreams and honor—the legacy that connects him to Cloud—is revealed in full in this grand saga that has broken the limits of an HD remaster.\r\n\r\n[h2]New Features[/h2]\r\n- All graphics fully remastered in HD, bringing the game to the latest console generation\r\n- Renewed 3D models, including characters and backgrounds, enriching the visual experience\r\n- Improved battle system providing a vastly smoother gameplay experience\r\n- Fully voiced dialogue in both English and Japanese\r\n- A newly arranged soundtrack from the original composer, Takeharu Ishimoto\r\n- Steam version supports up to 120FPS.\r\n*Recommended system requirements are set to 1920x1080 resolution and 60FPS, so playing at a higher resolution and/or framerate will require a display and PC with sufficient specifications to support them.","strSnippet":"CRISIS CORE -FINAL FANTASY VII- REUNION is a remaster of CRISIS CORE featuring updated graphics, combat systems and soundtrack. Follow the tale of SOLDIER operative Zack Fair, as he discovers the secrets of Shinra's dark experiments."}}]]